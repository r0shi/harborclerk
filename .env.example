# PostgreSQL
DATABASE_URL=postgresql+asyncpg://harbor_clerk:harbor_clerk_dev_password@postgres:5432/harbor_clerk
POSTGRES_USER=harbor_clerk
POSTGRES_PASSWORD=harbor_clerk_dev_password
POSTGRES_DB=harbor_clerk

# Stored originals (IMAP messages and attachments, uploads) use the filesystem
# backend on the `originals` volume; docker-compose.yml sets STORAGE_PATH.
# STORAGE_BACKEND=minio, MINIO_IMAGE and the MINIO_* lines are only for an
# install still running the opt-in `minio` profile, or copying out of it; see
# docs/upgrade-runbook.md#docker-minio-to-filesystem-storage.
# STORAGE_BACKEND=minio
# MINIO_IMAGE=
# MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin123
# MINIO_BUCKET=originals
# MINIO_USE_SSL=false

# Embedder
EMBEDDER_URL=http://embedder:8000

# Tika
TIKA_URL=http://tika:9998

# Local AI model (Ask, Research, summaries) under Docker Compose
# docker-compose.yml defaults these; uncomment to change them. They apply only
# to the Compose services (which set HC_DEPLOYMENT=compose), never to a source
# run that reads this file.
# The GGUF file llama-server serves, from the llama_models volume: a curated
# model's file name (Settings > Models lists them; download one there and it
# lands in the volume). The app treats this model as active while the file is
# present: until then Ask reports no model and the llama-server container
# waits, unhealthy. A load or restart is waited out up to 90 s per document;
# a document whose wait runs out is summarized without the model. While the
# server keeps failing, each document waits its own 90 s.
# Copy a file in under a temporary name and rename it. Empty runs no model.
# Changing it takes `docker compose up -d`; Activate cannot switch models
# under Compose. LLM_MODEL_ID is ignored there, even when this is empty.
# LLM_MODEL_FILE=Qwen3.5-4B-Q4_K_M.gguf
# llama-server's context (-c), which the app also budgets prompts to. Memory
# grows with it; raise --cache-ram in docker-compose.yml with it. 0 is not
# supported (it would mean the full training context) and runs as 8192.
# LLM_CONTEXT_TOKENS=8192

# App
API_HOST=0.0.0.0  # Docker needs 0.0.0.0; defaults to 127.0.0.1 when unset
SECRET_KEY=change-me-in-production
LOG_LEVEL=INFO

# Master encryption key for secret storage (32 random bytes, base64).
# Generate with:
#   python -c 'import base64, os; print(base64.b64encode(os.urandom(32)).decode())'
# See docs/secrets-and-keys.md for the lifecycle.
HARBOR_CLERK_MASTER_KEY=

# Concurrent encodes in the embedder. 1 serialises the single shared model.
EMBED_MAX_CONCURRENCY=1
# Release the GPU allocator cache once it exceeds this many MB. 0 disables.
# Only takes effect when a GPU is actually exposed to the process; the stock
# compose file reserves none, so CPU-only containers ignore it by design.
GPU_CACHE_HIGH_WATER_MB=1024
# Passages the reranker scores per forward pass. Four is fastest on Apple
# silicon and an eighth of the memory of the library default of 32 (#698).
RERANK_BATCH_SIZE=4
# e5-family models need query:/passage: prefixes; Granite-R2 does not.
# Both move together — this is the e5 rollback switch.
EMBED_NEEDS_PREFIX=false
