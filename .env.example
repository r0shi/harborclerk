# PostgreSQL
DATABASE_URL=postgresql+asyncpg://harbor_clerk:harbor_clerk_dev_password@postgres:5432/harbor_clerk
POSTGRES_USER=harbor_clerk
POSTGRES_PASSWORD=harbor_clerk_dev_password
POSTGRES_DB=harbor_clerk

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=originals
MINIO_USE_SSL=false

# Embedder
EMBEDDER_URL=http://embedder:8000

# Tika
TIKA_URL=http://tika:9998

# App
API_HOST=0.0.0.0  # Docker needs 0.0.0.0; defaults to 127.0.0.1 when unset
SECRET_KEY=change-me-in-production
LOG_LEVEL=INFO

# Master encryption key for secret storage (32 random bytes, base64).
# Generate with:
#   python -c 'import base64, os; print(base64.b64encode(os.urandom(32)).decode())'
# See docs/secrets-and-keys.md for the lifecycle.
HARBOR_CLERK_MASTER_KEY=

# Concurrent encodes in the embedder. 1 serialises the single shared model.
EMBED_MAX_CONCURRENCY=1
# Release the GPU allocator cache once it exceeds this many MB. 0 disables.
# Only takes effect when a GPU is actually exposed to the process; the stock
# compose file reserves none, so CPU-only containers ignore it by design.
GPU_CACHE_HIGH_WATER_MB=4096
# e5-family models need query:/passage: prefixes; Granite-R2 does not.
# Both move together — this is the e5 rollback switch.
EMBED_NEEDS_PREFIX=false
